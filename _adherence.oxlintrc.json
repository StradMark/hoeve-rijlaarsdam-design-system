{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/cta-band/**",
              "components/faq/**",
              "components/footer/**",
              "components/hero/**",
              "components/layout/**",
              "components/navigation/**",
              "components/page-outro/**",
              "components/photo-carousel/**",
              "components/pull-quote/**",
              "components/quote-bar/**",
              "components/seasonal/**",
              "components/site-map/**",
              "components/split-hero/**",
              "doc-page.js",
              "guidelines/seasonal/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:BDScript|Playfair Display|Italianno|Raleway))/i]",
        "message": "Font not provided by the design system. Available: BDScript, Playfair Display, Italianno, Raleway."
      },
      {
        "selector": "JSXOpeningElement[name.name='BenefitsPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|items|tone|style|key|ref|className|style|children)$/]",
        "message": "<BenefitsPanel> doesn't accept that prop. Declared props: kicker, title, items, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BenefitsPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:deep|sage)$/]",
        "message": "<BenefitsPanel> tone must be one of 'deep' | 'sage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|href|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, href, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|gold|outlineLight|outlineDark|white)$/]",
        "message": "<Button> tone must be one of 'primary' | 'gold' | 'outlineLight' | 'outlineDark' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|tone|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CarouselNav> doesn't accept that prop. Declared props: direction, tone, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselNav'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:prev|next)$/]",
        "message": "<CarouselNav> direction must be one of 'prev' | 'next'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselNav'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sage|gold|deep|white)$/]",
        "message": "<CarouselNav> tone must be one of 'sage' | 'gold' | 'deep' | 'white'."
